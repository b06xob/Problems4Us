# Problems4Us Environment Configuration

# Azure SQL Database (existing server: prius.database.windows.net)
AZURE_SQL_CONNECTION_STRING=Server=tcp:prius.database.windows.net,1433;Database=Problems4UsDB;User ID=your-user;Password=your-password;Encrypt=true;
AZURE_SQL_SERVER=prius.database.windows.net
AZURE_SQL_DATABASE=Problems4UsDB
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD=your-password

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Alternative: OpenAI direct
# OPENAI_API_KEY=sk-...

# AI Provider: "azure-openai" | "openai" | "mock"
AI_PROVIDER=mock

# App
# Local: http://localhost:3000  |  Production: https://problems4us.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Problems4Us

# Public site version (PUBLIC-SITE-VERSIONING-STANDARD) — set automatically by CI at build time.
# Do not hand-edit in production. Format: vYYYY.MM.DD-<7-char SHA>
# NEXT_PUBLIC_APP_VERSION=v2026.07.28-5a7694e
# NEXT_PUBLIC_GIT_COMMIT=5a7694e3680b9d2333790d45d46f7a7fe9e276a7
# NEXT_PUBLIC_DEPLOYED_AT=2026-07-28T18:20:00Z

# Stripe checkout (Month-2 / G7)
# Routes exist and fail-closed until these are set:
#   POST /api/checkout/session  → creates Checkout Session via Stripe REST when set
#   POST /api/checkout/webhook  → verify + paid_early_access + PlanEntitlements grant (M2.2)
#   GET  /api/checkout/entitlements → admin paid Builder cohort (?summary=1 or ?email=)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BUILDER_MONTHLY=price_...

# End-user accounts (M2.1) — email/password + httpOnly session cookie (p4u_session).
# Optional pepper for hashing session tokens; falls back to ADMIN_API_KEY when unset.
# SESSION_SECRET=
# Future managed IdP (optional replacement):
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# Owner / admin API access — required for /admin, ingest, source management, and AI tool endpoints.
# Generate a long random string and set the same value in Azure App Service application settings.
ADMIN_API_KEY=

# Optional: dedicated HMAC secret for Builder brief share links (M3.1).
# Falls back to ADMIN_API_KEY when unset. Public GET /api/share/briefs?token=
# BRIEF_SHARE_SECRET=

# Data Source API Keys
# GITHUB_TOKEN=

# Password-reset mailer (problems4us-22a) � SendGrid OR company SMTP
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# PASSWORD_RESET_FROM_EMAIL=
# SMTP_HOST=smtp.mail.att.net
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Observability (problems4us-30a)
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Centralized billing consumer (problems4us-09b) � shared secret, not isolated Stripe webhook
# BREIVAX_BILLING_FORWARD_SECRET=
